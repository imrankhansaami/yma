# ============================================================
# YMA frontend - PRODUCTION environment
#
# Copy this file to  frontend/.env.production  on the server BEFORE
# building. Next.js loads it automatically during `next build`.
#
#   cp frontend/.env.production.example frontend/.env.production
#   nano frontend/.env.production
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined into the JavaScript
# bundle at BUILD time. Editing this file after a build has no effect
# until you run `npm run build:frontend` again.
# ============================================================

# Backend API base URL.
#
# The route handler at frontend/src/app/api/v1/[...path]/route.ts proxies
# browser /api/v1/* requests to this address server-side, so the backend
# never has to be reachable from the browser. Loopback is correct when
# both processes run on the same droplet.
NEXT_PUBLIC_SERVER_URI=http://127.0.0.1:8001

# --- Canonical public site URL ------------------------------
# Used by sitemap.xml, robots.txt, canonical tags and JSON-LD.
#   staging:    https://yma.simplif-ai.co
#   production: https://ymabouncycastles.uk
NEXT_PUBLIC_SITE_URL=https://ymabouncycastles.uk

# --- Google Maps Embed --------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# --- Google Places (live testimonials) ----------------------
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_PLACES_PLACE_ID=

# --- ISR revalidation ---------------------------------------
# MUST be byte-for-byte identical to REVALIDATION_SECRET in
# backend/.env, or admin edits will not refresh the public pages.
REVALIDATION_SECRET=
