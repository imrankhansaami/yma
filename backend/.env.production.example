# ============================================================
# YMA backend - PRODUCTION environment
#
# Copy this file to  backend/.env  on the server, then fill in the
# real values. The filled-in .env must NEVER be committed.
#
#   cp backend/.env.production.example backend/.env
#   nano backend/.env
# ============================================================

# --- Runtime ------------------------------------------------
NODE_ENV=production
PORT=8001

# --- Database (MongoDB Atlas) -------------------------------
# Keep the existing Atlas cluster. Allow the droplet IP under
# Atlas -> Network Access. Rotate the password if it was ever shared.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# --- Public URLs --------------------------------------------
# The backend POSTs ${FRONTEND_URL}/api/revalidate after content changes,
# so this must be the real, publicly reachable frontend URL.
FRONTEND_URL=https://ymabouncycastles.uk
BASE_URL=https://ymabouncycastles.uk

# Used to build password-reset and email-verification links in emails.
API_PUBLIC_URL=https://ymabouncycastles.uk

# Comma-separated list of browser origins allowed to call the API.
# Include both the apex and the www host.
CORS_ORIGIN=https://ymabouncycastles.uk,https://www.ymabouncycastles.uk

# Where admin email notifications should link to.
ADMIN_URL=https://ymabouncycastles.uk/admin

# --- Auth ---------------------------------------------------
# Generate fresh values with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_SALT_ROUNDS=12

# --- Google OAuth -------------------------------------------
# Register the callback URL in Google Cloud Console -> Credentials:
#   https://ymabouncycastles.uk/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://ymabouncycastles.uk/api/v1/auth/google/callback

# --- Cloudinary (image uploads) -----------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email --------------------------------------------------
SENDGRID_API_KEY=
SENDER_EMAIL=
EMAIL_FROM=
EMAIL_FROM_NAME=YMA Bouncy Castle
EMAIL_USER=
RESEND_API_KEY=
ADMIN_EMAIL=
SUPPORT_EMAIL=

# --- ISR revalidation ---------------------------------------
# MUST be byte-for-byte identical to REVALIDATION_SECRET in
# frontend/.env.production, or admin edits will not refresh the
# public pages immediately.
REVALIDATION_SECRET=

# --- Optional debug -----------------------------------------
# DEBUG_ID=
