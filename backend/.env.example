JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# Email (Resend)
RESEND_API_KEY=
SENDER_EMAIL=
EMAIL_FROM=
EMAIL_FROM_NAME=YMA
EMAIL_USER=
ADMIN_EMAIL=
SUPPORT_EMAIL=

# Cloudinary (Image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ISR Revalidation (shared secret with frontend)
REVALIDATION_SECRET=

