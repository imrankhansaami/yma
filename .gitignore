# Test / coverage
coverage/

# One-off DB scripts: seed, verify and repair. They are run from the repo root
# or the backend directory and deleted after use, but an interrupted session can
# leave one behind; without this, the next `git add -A` on the server commits
# it. Scoped to these two directories, so the tracked deploy scripts and the
# frontend's own .mjs configs/scripts stay visible to git.
backend/*.mjs
backend/*.cjs
backend/*.sh
/*.mjs
/*.cjs
/*.sh

# JSON snapshots written before a seed overwrites records, and one-off data
# backups. These are the recovery copies: large and per-run, so they stay out
# of git, but do not delete them without checking.
backend/seed-backups/
backend/removed-*-backup-*.json

# OpenChamber
.openchamber/