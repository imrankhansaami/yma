# Build output
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# Dependencies
.pnp
.pnp.js

# Environment
.env
.env*.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test / coverage
coverage/

# Seed, verify and one-off repair scripts. These are run from the backend
# directory and deleted after use, but an interrupted session can leave one
# behind; without this, the next `git add -A` on the server commits it.
backend/*.mjs
backend/*.cjs
backend/*.sh

# JSON snapshots written before a seed overwrites records, and one-off data
# backups. These are the recovery copies: large and per-run, so they stay out
# of git, but do not delete them without checking.
backend/seed-backups/
backend/removed-*-backup-*.json

# OpenChamber
.openchamber/